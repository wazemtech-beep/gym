# Database (Aiven PostgreSQL connection string)
DATABASE_URL="postgres://avnadmin:YOUR_PASSWORD@YOUR_AIVEN_HOST:PORT/defaultdb?sslmode=require&connection_limit=5&pool_timeout=20"

# Initial Owner Credentials for `npm run setup:owner` CLI setup
INITIAL_OWNER_EMAIL="owner@oxgengym.com"
INITIAL_OWNER_PASSWORD="SET_A_UNIQUE_STRONG_OWNER_PASSWORD"

# App & Sessions
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
SESSION_SECRET="your_secure_random_session_secret_min_32_chars"
CRON_SECRET="set_a_unique_random_cron_secret_at_least_16_characters"

# Google SMTP (For branded emails & activation links)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-google-app-password"

# Cloudinary (For member photos, progress photos, expense bills & transfer proofs)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"

# Firebase Client (For Web Push & Cloud Messaging)
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_firebase_project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_firebase_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_firebase_project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"
NEXT_PUBLIC_FIREBASE_VAPID_KEY="your_vapid_key"

# Firebase Admin SDK (Server-Side Push Notifications via FCM)
FIREBASE_PROJECT_ID="your_firebase_project_id"
# Vercel: one-line JSON from the Firebase Admin service-account file, server-only.
# Use `npm run deploy:env -- --url https://YOUR-SITE.vercel.app` to prepare it locally.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# Local development only; Vercel uses FIREBASE_SERVICE_ACCOUNT_JSON instead.
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

