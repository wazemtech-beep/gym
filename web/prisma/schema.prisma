  sessions       WorkoutSession[]

  @@index([gymMemberId])
  @@index([trainerId])
  @@index([status])
}

model WorkoutDay {
  id          String            @id @default(cuid())
  planId      String
  plan        WorkoutPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
