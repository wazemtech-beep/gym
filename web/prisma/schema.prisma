// ============================================================================
// FEATURE 20: NOTIFICATIONS & ANNOUNCEMENTS
// ============================================================================

enum NotificationCategory {
  PAYMENT
  MEMBERSHIP
  TRAINING
  ANNOUNCEMENT
  OPERATIONAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationDeliveryStatus {
  QUEUED
  ACCEPTED
  FAILED
  SKIPPED
  READ
}

enum AnnouncementAudience {
  ALL_MEMBERS
  ACTIVE_MEMBERS
  STAFF
  SELECTED_MEMBERS
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
}

model NotificationEvent {
  id              String               @id @default(cuid())
  eventType       String               // INVOICE_ISSUED, PAYMENT_CONFIRMED, INSTALLMENT_DUE, etc.
  recipientUserId String
  recipientUser   User                 @relation("RecipientNotificationEvents", fields: [recipientUserId], references: [id], onDelete: Cascade)
  title           String
  message         String
  category        NotificationCategory @default(OPERATIONAL)
  dedupKey        String?              @unique // prevents duplicate creation on repeated runs or retries
  entityType      String?              // INVOICE, PAYMENT, RECEIPT, WORKOUT_PLAN, etc.
  entityId        String?
  actionUrl       String?
  metadata        Json?
  processed       Boolean              @default(false)
  createdAt       DateTime             @default(now())

  @@index([processed, createdAt])
  @@index([recipientUserId])
}

model Notification {
  id             String                     @id @default(cuid())
  userId         String
  user           User                       @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title          String
  message        String
  category       NotificationCategory       @default(OPERATIONAL)
  entityType     String?
  entityId       String?
  actionUrl      String?
  isRead         Boolean                    @default(false)
  readAt         DateTime?
  deliveryStatus NotificationDeliveryStatus @default(QUEUED)
  emailStatus    NotificationDeliveryStatus?
  emailError     String?
  pushStatus     NotificationDeliveryStatus?
  pushError      String?
  eventId        String?
  announcementId String?
  announcement   Announcement?              @relation("AnnouncementNotifications", fields: [announcementId], references: [id], onDelete: SetNull)
  createdAt      DateTime                   @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([category])
  @@index([announcementId])
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation("UserNotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)
  emailPayment       Boolean  @default(true)
  emailMembership    Boolean  @default(true)
  emailTraining      Boolean  @default(true)
  emailAnnouncements Boolean  @default(true)
  pushPayment        Boolean  @default(true)
  pushMembership     Boolean  @default(true)
  pushTraining       Boolean  @default(true)
  pushAnnouncements  Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model DevicePushToken {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserDeviceTokens", fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  platform    String   @default("android") // android, ios, web
  deviceModel String?
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId])
}

model ReminderScheduleConfig {
