  dayNumber   Int               @default(1)
  order       Int               @default(0)

  exercises   WorkoutExercise[]
  sessions    WorkoutSession[]

  @@index([planId])
}

model WorkoutExercise {
  id                  String       @id @default(cuid())
  workoutDayId        String
  workoutDay          WorkoutDay   @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  name                String
  type                ExerciseType @default(STRENGTH)
  sets                Int?
  reps                String?      // e.g. "10" or "8-12"
  targetLoad          String?      // e.g. "20 kg", "RPE 8"
  durationMinutes     Int?
  distanceMeters      Int?
  restSeconds         Int?         @default(60)
  instructions        String?      // Technique cues
  alternativeExercise String?
  demoVideoUrl        String?
  order               Int          @default(0)

  exerciseLogs        ExerciseLog[]

  @@index([workoutDayId])
}

model WorkoutSession {
  id              String               @id @default(cuid())
  gymMemberId     String
  gymMember       GymMember            @relation("MemberWorkoutSessions", fields: [gymMemberId], references: [id], onDelete: Cascade)
  planId          String?
  plan            WorkoutPlan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  workoutDayId    String?
  workoutDay      WorkoutDay?          @relation(fields: [workoutDayId], references: [id], onDelete: SetNull)
  planVersion     Int?
  sessionDate     DateTime             @default(now())
  status          WorkoutSessionStatus @default(NOT_STARTED)
  startedAt       DateTime?
  completedAt     DateTime?
  durationMinutes Int?
  skipReason      String?              // "Equipment unavailable", "Discomfort", "Time shortage"
  memberNotes     String?
  trainerFeedback String?
  reviewedById    String?
  reviewedBy      User?                @relation("ReviewedWorkoutSessions", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  isSynced        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  exerciseLogs    ExerciseLog[]

  @@index([gymMemberId])
  @@index([sessionDate])
  @@index([status])
}

model ExerciseLog {
  id                String           @id @default(cuid())
  sessionId         String
  session           WorkoutSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workoutExerciseId String?
  workoutExercise   WorkoutExercise? @relation(fields: [workoutExerciseId], references: [id], onDelete: SetNull)
  exerciseName      String
  exerciseType      ExerciseType     @default(STRENGTH)
  setNumber         Int              @default(1)
  plannedReps       String?
  plannedWeight     Float?
  actualReps        Int?
  actualWeight      Float?
  actualDuration    Int?
  isSkipped         Boolean          @default(false)
  skipReason        String?
  notes             String?
  createdAt         DateTime         @default(now())

  @@index([sessionId])
}

model Announcement {
  id               String               @id @default(cuid())
  title            String
  content          String
  category         String               @default("GENERAL") // GENERAL, HOLIDAY, PROMO, MAINTENANCE
  isPublished      Boolean              @default(true)
  pinned           Boolean              @default(false)
  audience         AnnouncementAudience @default(ALL_MEMBERS)
  priority         AnnouncementPriority @default(NORMAL)
  publishAt        DateTime             @default(now())
  expiresAt        DateTime?
  channels         String[]             @default(["IN_APP"]) // IN_APP, EMAIL, PUSH
  attachmentUrl    String?
  targetMemberIds  String[]             @default([])
  version          Int                  @default(1)
  recipientCount   Int                  @default(0)
  emailSentCount   Int                  @default(0)
  emailFailedCount Int                  @default(0)
  pushSentCount    Int                  @default(0)
  authorId         String
  author           User                 @relation("AuthoredAnnouncements", fields: [authorId], references: [id])
  notifications    Notification[]       @relation("AnnouncementNotifications")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([isPublished])
  @@index([pinned])
  @@index([publishAt])
  @@index([expiresAt])
}

