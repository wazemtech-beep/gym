model WorkoutPlan {
  id             String            @id @default(cuid())
  title          String
  goal           String
  startDate      DateTime          @default(now())
  endDate        DateTime?
  status         WorkoutPlanStatus @default(DRAFT)
  version        Int               @default(1)
  gymMemberId    String
  gymMember      GymMember         @relation("MemberWorkoutPlans", fields: [gymMemberId], references: [id], onDelete: Cascade)
  trainerId      String
  trainer        User              @relation("TrainerCreatedPlans", fields: [trainerId], references: [id])
  weeklySchedule String?           // e.g. "Monday, Wednesday, Friday"
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

