  updatedAt          DateTime            @updatedAt

  @@index([membershipId])
  @@index([gymMemberId])
  @@index([status])
}

model FeePlanHistory {
  id               String       @id @default(cuid())
  feePlanId        String
  feePlan          FeePlan      @relation(fields: [feePlanId], references: [id], onDelete: Cascade)
  version          Int
  name             String
  description      String?
  durationValue    Int
  durationUnit     DurationUnit @default(CALENDAR_MONTHS)
  membershipFee    Float
  admissionFee     Float        @default(0)
  includedServices String?
  eligibility      String?
  paymentTerms     PaymentTerms @default(FULL_PAYMENT_ONLY)
  changedById      String?
  changedBy        User?        @relation("FeePlanChanges", fields: [changedById], references: [id])
  changeReason     String?
  createdAt        DateTime     @default(now())

  @@index([feePlanId])
  @@index([version])
}

model ExpenseRefund {
  id                 String            @id @default(cuid())
  refundNumber       String            @unique // e.g. "OXG-VRF-000101"
  expenseId          String
  expense            Expense           @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  amount             Float
  refundDate         DateTime          @default(now())
  method             PaymentMethod     @default(CASH)
  receivingAccountId String?
  receivingAccount   ReceivingAccount? @relation(fields: [receivingAccountId], references: [id], onDelete: SetNull)
  cashSessionId      String?
  cashSession        CashSession?      @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  reason             String
  recordedById       String
  recordedBy         User              @relation("RecordedExpenseRefunds", fields: [recordedById], references: [id])
  createdAt          DateTime          @default(now())

  @@index([expenseId])
  @@index([refundDate])
}
