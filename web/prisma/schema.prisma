// ============================================================================

enum FitnessConnectionStatus {
  DISCONNECTED
  CONNECTED
  LIMITED_PERMISSIONS
  SETUP_REQUIRED
  UNSUPPORTED
}

enum FitnessDataCategory {
  STEPS
  DISTANCE
  EXERCISE_SESSIONS
  ACTIVE_CALORIES
}

model FitnessConnection {
  id                          String                  @id @default(cuid())
  gymMemberId                 String                  @unique
  gymMember                   GymMember               @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  status                      FitnessConnectionStatus @default(DISCONNECTED)
  platform                    String                  @default("HEALTH_CONNECT") // Android Health Connect
  appVersion                  String?
  deviceModel                 String?
  reportedPermissions         FitnessDataCategory[]   @default([])
  backendUploadConsent        Boolean                 @default(false)
  backendUploadConsentVersion  String?
  backendUploadConsentAt      DateTime?
  trainerSharingEnabled       Boolean                 @default(false)
  trainerSharingCategories    FitnessDataCategory[]   @default([])
  trainerConfirmedCoachId     String?                 // Current assigned trainer when sharing was confirmed
  historyRangeType            String?                 @default("ALL") // ALL, LAST_30_DAYS, LAST_90_DAYS, CONSENT_ONWARD
  historyRangeStart           DateTime?               // Date boundary before which trainer CANNOT see data
  trainerSharingConsentVersion String?                @default("v1.0")
  trainerSharingConfirmedAt   DateTime?
  lastSyncedAt                DateTime?
